generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String?
  username  String  @unique
  email     String  @unique
  password  String

  @@map("user")
}

// github.com/kleydon/prisma-session-store#model
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
