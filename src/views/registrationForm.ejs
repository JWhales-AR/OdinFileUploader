<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta
      name="viewport"
      content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0"
    >
    <link href="/style.css" rel="stylesheet">
    <title>Odin File Uploader</title>
  </head>
  <body>
    <main>
      <form method="POST" action="/user/register">
        <fieldset>
          <p>Registration Form</p>
          <div class="form-input-wrapper">
            <label for="register-first-name">First Name</label>
            <input
              id="register-first-name" name="firstName" type="text"
              required
            >
            <label for="register-last-name">Last Name</label>
            <input
              id="register-last-name" name="lastName" type="text"
            >
          </div>
          <div class="form-input-wrapper">
            <label for="register-username">Username</label>
            <input
              id="register-username" name="username" type="text"
              required
            >
            <label for="register-email">Email</label>
            <input
              name="email" type="text" id="register-email" required
            >
          </div>
          <div class="form-input-wrapper">
            <label for="register-password">Password</label>
            <input
              id="register-password" name="password" type="text"
              required
            >
          </div>
          <div class="form-input-wrapper">
            <label for="register-confirm-password">Confirm Password</label>
            <input
              id="register-confirm-password" name="confirmPassword"
              type="text" required
            >
          </div>
          <button type="submit">Register</button>
        </fieldset>
      </form>
    </main>
  </body>
</html>
