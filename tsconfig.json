{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "types": ["node"],
    "esModuleInterop": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["src", "*.js", "*.ts"]
}
